{
  "name": "bronepehota-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "PORT=3001 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "cucumber-js --config e2e/cucumber.yaml e2e/features/*.feature",
    "test:e2e:headed": "HEADED=1 cucumber-js --config e2e/cucumber.yaml e2e/features/*.feature",
    "test:e2e:debug": "SLOWMO=100 cucumber-js --config e2e/cucumber.yaml e2e/features/*.feature",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e:ci": "cucumber-js --config e2e/cucumber.yaml e2e/features/*.feature --format json:e2e/reports/cucumber-report.json --format summary",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm run test"
  },
  "dependencies": {
    "@serwist/next": "^9.5.3",
    "clsx": "^2.1.0",
    "lucide-react": "^0.330.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@cucumber/pretty-formatter": "^2.4.1",
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.4",
    "globals": "^15.14.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.49.0",
    "postcss": "^8",
    "serwist": "^9.5.3",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.19.0"
  },
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.0.0"
  }
}
