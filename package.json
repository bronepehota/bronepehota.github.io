{
  "name": "bronepehota-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "PORT=3001 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e:ci": "playwright test",
    "type-check": "tsc --noEmit",
    "check:copy-paste": "python3 tools/check_copy_paste.py --self-check && python3 tools/check_copy_paste.py --content 'src/content/history/*.md' --sources 'docs/lore-sources/robogear-stories/*.md' && python3 tools/check_copy_paste.py --content 'src/content/campaigns/*.md' --sources 'docs/lore-sources/v-chertischev/*.md' && python3 tools/check_copy_paste.py --content 'src/content/world/*.md' --sources 'docs/lore-sources/vk-starsys/*.md' && python3 tools/check_copy_paste.py --content 'src/content/campaigns/*.md' 'src/content/world/*.md' --sources 'docs/lore-sources/roboteh/*.md'",
    "validate": "npm run type-check && npm run lint && npm run test"
  },
  "dependencies": {
    "@serwist/next": "^9.5.3",
    "@types/nprogress": "^0.2.3",
    "clsx": "^2.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.330.0",
    "nanoid": "^5.1.6",
    "next": "14.2.35",
    "nprogress": "^0.2.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.4",
    "globals": "^15.14.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.49.0",
    "postcss": "^8",
    "serwist": "^9.5.3",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.19.0"
  },
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.0.0"
  }
}
