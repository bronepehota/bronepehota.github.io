# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX

# Google Drive integration (optional — enables cloud sync)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- SEO / discoverability (all optional, sensible defaults) ---
# Canonical site origin. Defaults to the GitHub Pages URL (luxor.github.io/bronepehota).
# Set to a custom domain (e.g. https://bronepehota.ru) to serve from the domain
# ROOT: basePath /bronepehota auto-disables, and robots.txt/sitemap.xml land at
# the domain root (fixing crawler auto-discovery). Also set public/CNAME + DNS.
NEXT_PUBLIC_SITE_URL=

# Search-Console / Webmaster site verification meta content values.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Yandex.Metrica counter id (numeric string). Omit to disable.
NEXT_PUBLIC_YANDEX_METRICA_ID=

